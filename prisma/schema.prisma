generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String   @unique
  name      String?
  imageUrl  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Workspaces this user created. Membership/roles for all workspaces live in the Clerk organization.
  createdWorkspaces Workspace[]
  agentPrompts      AgentPrompt[]
}

enum WorkspaceStatus {
  PLANNING
  IN_PROGRESS
  IN_REVIEW
  DONE
}

model Workspace {
  id          String  @id @default(cuid())
  name        String
  description String?
  creatorId   String
  creator     User    @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  clerkOrgId  String?

  // Dashboard kanban column + order within it. position is a float so a dropped card can
  // take the midpoint between its neighbours - only the moved card ever gets written.
  status     WorkspaceStatus @default(PLANNING)
  position   Float           @default(0)
  shareToken String?         @unique
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  doc          Doc?
  canvas       Canvas?
  agentPrompts AgentPrompt[]

  @@index([creatorId])
  @@index([clerkOrgId])
}

model Doc {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  content     Json?
  yjsState    Bytes?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model Canvas {
  id          String   @id @default(cuid())
  workspaceId String   @unique
  content     Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  workspace Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
}

model AgentPrompt {
  id          String   @id @default(cuid())
  ownerId     String
  userId      String
  workspaceId String?
  createdAt   DateTime @default(now())

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace Workspace? @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
}
